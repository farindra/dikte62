{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dikte Meeting Facts",
  "type": "object",
  "required": ["meeting", "summary", "decisions", "requirements", "action_items", "open_questions"],
  "additionalProperties": false,
  "properties": {
    "meeting": {
      "type": "object",
      "required": ["title", "date", "duration_min", "topics"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string" },
        "duration_min": { "type": "number" },
        "topics": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "speakers_mentioned": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "required": ["tldr", "narrative"],
      "additionalProperties": false,
      "properties": {
        "tldr": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 5 },
        "narrative": { "type": "string" },
        "out_of_scope": { "type": "array", "items": { "type": "string" } }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "confidence", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^D-[0-9]{2,}$" },
          "text": { "type": "string" },
          "made_by": { "type": "string" },
          "confidence": { "enum": ["high", "medium", "low"] },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["t", "quote"],
              "additionalProperties": false,
              "properties": {
                "t": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$" },
                "quote": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "text", "priority", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^R-[0-9]{2,}$" },
          "type": { "enum": ["functional", "non_functional", "business_rule"] },
          "text": { "type": "string" },
          "priority": { "enum": ["must", "should", "could", "wont"] },
          "rationale": { "type": "string" },
          "confidence": { "enum": ["high", "medium", "low"] },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["t", "quote"],
              "additionalProperties": false,
              "properties": {
                "t": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$" },
                "quote": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "task", "owner_confidence", "status", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^A-[0-9]{2,}$" },
          "task": { "type": "string" },
          "owner": { "type": "string" },
          "owner_confidence": { "enum": ["explicit", "inferred", "unknown"] },
          "due": { "type": "string" },
          "status": { "enum": ["open", "done", "blocked"] },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["t", "quote"],
              "additionalProperties": false,
              "properties": {
                "t": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$" },
                "quote": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^Q-[0-9]{2,}$" },
          "question": { "type": "string" },
          "asked_by": { "type": "string" },
          "status": { "enum": ["unanswered", "needs_confirmation", "answered"] },
          "note": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["t", "quote"],
              "additionalProperties": false,
              "properties": {
                "t": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}:[0-9]{2}$" },
                "quote": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "glossary_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term", "as_spoken"],
        "additionalProperties": false,
        "properties": {
          "term": { "type": "string" },
          "as_spoken": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
